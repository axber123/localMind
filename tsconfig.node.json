{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"],
      "@main/*": ["src/main/*"],
      "@renderer/*": ["src/renderer/*"]
    }
  },
  "include": [
    "src/main/**/*.ts",
    "src/server/**/*.ts",
    "src/web/**/*.ts",
    "src/shared/**/*.ts",
    "vite.server.config.ts",
    "vite.web.config.ts",
    "tests/**/*.ts",
    "vitest.config.ts"
  ]
}
